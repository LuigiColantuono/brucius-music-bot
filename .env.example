# ==========================================
# 🎵 BRUCIUS MUSIC BOT - ENVIRONMENT CONFIG
# ==========================================

# [REQUIRED] Discord Bot Token
# Ottenibile dalla Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# [REQUIRED] Lavalink v4 Audio Node Configuration
# Host, porta e password del server Lavalink v4
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# [REQUIRED] PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://postgres:botpassword123@localhost:5432/brucius_db?schema=public"

# [OPTIONAL] Redis Cache (Opzionale, il bot funziona anche senza Redis)
REDIS_URL="redis://localhost:6379"

# [OPTIONAL] Bot Internal API & Dashboard Bridge Port (Default: 3003)
MUSIC_BOT_API_PORT=3003

# [OPTIONAL] Cross-Hosting & Sharding Grid Configuration
BCH_BRIDGE_HOST=localhost
BCH_PORT=4444
BCH_AUTH_TOKEN="brucius_grid_secure_token_2026_!"
BCH_TOTAL_SHARDS=auto
BCH_TOTAL_MACHINES=1
BCH_SHARDS_PER_CLUSTER=2

# [OPTIONAL] Logging & Environment
NODE_ENV=production
DEBUG=false
